# =============================================================================
# CV IA APP - Environment Variables Configuration (EXAMPLE)
# =============================================================================
# Copia este archivo a .env y completa los valores

# -----------------------------------------------------------------------------
# 🤖 APIFREELLM API - IA Service
# Servicio de IA para generación de CVs y cartas de presentación
# Documentación: https://apifreellm.com/
# IMPORTANTE: la API key se configura SOLO en backend, no en Vite.
# -----------------------------------------------------------------------------
# Backend: API Key de ApiFreeLLM
APIFREELLM_API_KEY=your_apifreellm_api_key_here
# Backend: URL del endpoint de chat (opcional, por defecto: https://apifreellm.com/api/v1/chat)
APIFREELLM_API_URL=https://apifreellm.com/api/v1/chat
APIFREELLM_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# 🌐 API BASE URL
# URL base del backend
# -----------------------------------------------------------------------------
# En desarrollo se usa proxy de Vite (/api), puede quedar vacío
# En producción: URL completa del backend, ej: https://api.tu-dominio.com
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# 📧 MAIL SERVER - Configuración del Servidor de Correo (Backend)
# -----------------------------------------------------------------------------
# Puerto del servidor backend
PORT=5174
# Orígenes permitidos para CORS
CORS_ORIGINS=http://localhost:5173

# Configuración SMTP
# Host del servidor SMTP (ejemplo: smtp.gmail.com, mail.tu-dominio.com)
SMTP_HOST=smtp.example.com
# Puerto SMTP - Recomendado: 587 con STARTTLS
SMTP_PORT=587
# SSL/TLS directo (false = usa STARTTLS)
SMTP_SECURE=false
# Usuario SMTP (tu correo)
SMTP_USER=your_email@example.com
# Contraseña SMTP
SMTP_PASS=your_smtp_password_here

# Remitente y destinatario de correos
MAIL_FROM=noreply@example.com
SUPPORT_INBOX=support@example.com
# Lista de destinatarios para alertas de descarga (separados por coma)
DOWNLOAD_ALERT_RECIPIENTS=admin@example.com

# -----------------------------------------------------------------------------
# 🔐 RECAPTCHA - Protección contra Bots
# Obtén tus claves en https://www.google.com/recaptcha/
# -----------------------------------------------------------------------------
# Frontend (Vite) - Site Key para el widget
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Backend - Verificación del token
# Opción 1: reCAPTCHA Enterprise (recomendado)
RECAPTCHA_PROJECT_ID=your_project_id
RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_MIN_SCORE=0.5

# Opción 2: reCAPTCHA v2 (fallback con siteverify)
RECAPTCHA_SECRET_KEY=your_secret_key

# -----------------------------------------------------------------------------
# 🛡️ ANTI-ABUSO & RATE LIMITING
# Configuraciones de seguridad para prevenir abuso
# -----------------------------------------------------------------------------
# Trust Proxy - Habilitar si estás detrás de proxy (Nginx/Cloudflare)
# Ejemplo: TRUST_PROXY=1
TRUST_PROXY=

# Rate Limiting para formulario de soporte
# Límite de peticiones por ventana de tiempo
SUPPORT_RATE_LIMIT=5
# Comenzar a ralentizar después de N peticiones
SUPPORT_SLOWDOWN_AFTER=2
# Longitud máxima del mensaje de soporte
SUPPORT_MESSAGE_MAX_LEN=3000

# Rate Limiting para tracking de descargas
DOWNLOAD_RATE_LIMIT=20
DOWNLOAD_SLOWDOWN_AFTER=5

# -----------------------------------------------------------------------------
# 📬 CONFIRMACIONES DE SOPORTE
# Envío de email de confirmación al usuario
# -----------------------------------------------------------------------------
# Enviar confirmación de recepción al usuario
SEND_SUPPORT_CONFIRMATION=true
# Cooldown entre confirmaciones (ms) - 1 hora por defecto
SUPPORT_CONFIRMATION_COOLDOWN_MS=3600000

# -----------------------------------------------------------------------------
# 🔧 DESARROLLO - Solo para ambiente de desarrollo
# ⚠️ NUNCA habilitar estos en producción
# -----------------------------------------------------------------------------
# Bypass de reCAPTCHA en frontend (solo desarrollo)
VITE_RECAPTCHA_BYPASS=false
# Bypass de reCAPTCHA en backend (solo desarrollo)
RECAPTCHA_BYPASS=false