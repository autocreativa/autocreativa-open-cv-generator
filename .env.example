# OpenRouter API Configuration
# Get your API key at https://openrouter.ai/
VITE_OPENROUTER_API_KEY=your_api_key_here
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
VITE_OPENROUTER_MODEL=x-ai/grok-code-fast-1

# API base URL del backend (producción)
# En desarrollo se usa proxy de Vite (/api), así que puedes dejar vacío.
# En producción pon la URL completa del backend, ej: https://api.tu-dominio.com
VITE_API_BASE_URL=

# reCAPTCHA (frontend)
# Obtén tus claves en https://www.google.com/recaptcha/
# Si usas reCAPTCHA Enterprise, esta es la site key de Enterprise.
VITE_RECAPTCHA_SITE_KEY=

# DEV ONLY: permite probar soporte sin reCAPTCHA cuando la key aún no autoriza localhost
VITE_RECAPTCHA_BYPASS=false

# Mail Server (backend) Configuration
PORT=5174
CORS_ORIGINS=http://localhost:5173

# reCAPTCHA (backend)
# Enterprise (recomendado)
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# DEV ONLY: bypass de verificación reCAPTCHA en el backend
RECAPTCHA_BYPASS=false

# Fallback (solo si usas reCAPTCHA v2 siteverify)
RECAPTCHA_SECRET_KEY=

SMTP_HOST=mail.autocreativa.com
# Recomendado: 587 con STARTTLS
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contacto@autocreativa.com
SMTP_PASS=your_smtp_pass_here

MAIL_FROM=contacto@autocreativa.com
SUPPORT_INBOX=contacto@autocreativa.com

# Anti-abuso (opcional)
# Si estás detrás de un proxy (Nginx/Cloudflare), habilita trust proxy
# Ej: TRUST_PROXY=1
TRUST_PROXY=

# Rate limit / slowdown para soporte
SUPPORT_RATE_LIMIT=5
SUPPORT_SLOWDOWN_AFTER=2
SUPPORT_MESSAGE_MAX_LEN=3000

# Confirmación al usuario (recomendado mantener true pero con cooldown)
SEND_SUPPORT_CONFIRMATION=true
SUPPORT_CONFIRMATION_COOLDOWN_MS=3600000

# Rate limit / slowdown para track-download
DOWNLOAD_RATE_LIMIT=20
DOWNLOAD_SLOWDOWN_AFTER=5

# Comma-separated list
DOWNLOAD_ALERT_RECIPIENTS=nelsonalejandroramosrivera@gmail.com