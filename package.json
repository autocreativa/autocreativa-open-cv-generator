{
  "name": "autocreativa-open-cv-generator",
  "version": "0.1.0",
  "description": "Generador de CV con plantillas, editor y funciones de IA (OpenRouter).",
  "author": "autocreativa.com",
  "homepage": "https://autocreativa.com/cv-generator",
  "repository": {
    "type": "git",
    "url": "https://github.com/autocreativa/autocreativa-open-cv-generator.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "DOTENV_CONFIG_PATH=.env.development node server/index.js",
    "dev:all": "concurrently -n web,mail -c green,blue \"vite\" \"DOTENV_CONFIG_PATH=.env.development node server/index.js\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "DOTENV_CONFIG_PATH=.env.production node server/index.js"
  },
  "dependencies": {
    "@google-cloud/recaptcha-enterprise": "^6.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-slow-down": "^2.1.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.563.0",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tesseract.js": "^6.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
